Bootstrap: docker
From: python:3.14-slim-bookworm

%post
    # Set environment variables for non-interactive installation
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC
    
    # Update package lists and install system dependencies
    apt-get update && apt-get install -y \
        curl \
        wget \
        ca-certificates \
        gcc \
        g++ \
        gfortran \
        make \
        cmake \
        git \
        build-essential \
        pkg-config \
        libpq-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libgeos-dev \
        libproj-dev \
        libsqlite3-dev \
        libbz2-dev \
        libffi-dev \
        libncurses5-dev \
        libreadline-dev \
        liblzma-dev \
        zlib1g-dev \
        libzstd-dev \
        libjpeg-dev \
        libpng-dev \
        libtiff-dev \
        libhdf5-dev \
        libnetcdf-dev \
        libnetcdf-c++4-dev \
        netcdf-bin \
        libopenblas-dev \
        liblz4-dev \
        libsnappy-dev \
        libbrotli-dev \
        proj-bin \
        libproj-dev \
        libgeos++-dev \
        postgresql-client \
        postgis \
        unzip \
        gdal-bin \
        libgdal-dev \
        zsh \
        lsd \
        libopenmpi-dev \
        openmpi-bin

    # Install DuckDB CLI
    curl https://install.duckdb.org | sh
    cp /root/.duckdb/cli/latest/duckdb /usr/local/bin/
    chmod +x /usr/local/bin/duckdb

    # Install UV to a system-wide location
    curl -LsSf https://astral.sh/uv/install.sh | sh
    cp /root/.local/bin/uv /usr/local/bin/
    cp /root/.local/bin/uvx /usr/local/bin/
    chmod +x /usr/local/bin/uv /usr/local/bin/uvx

    # Install Oh My Posh
    wget https://github.com/JanDeDobbeleer/oh-my-posh/releases/latest/download/posh-linux-amd64 -O /usr/local/bin/oh-my-posh
    chmod +x /usr/local/bin/oh-my-posh

    # Download atomic theme (will be overwritten if local file exists)
    mkdir -p /opt/themes
    wget -O /opt/themes/atomic.omp.json https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/atomic.omp.json

    # Clone the seaice-cyclone-imagery repository
    git clone https://github.com/aashraychegu/seaice-cyclone-imagery.git /opt/project

    # Create venv and sync dependencies
    cd /opt/project
    /usr/local/bin/uv venv .venv --python 3.14
    /usr/local/bin/uv sync

    # Install TempestExtremes
    cd /opt
    git clone https://github.com/ClimateGlobalChange/tempestextremes.git
    cd tempestextremes
    
    # Create build directory
    mkdir -p build
    cd build
    
    # Configure with CMake
    cmake \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/tempestextremes \
        -DENABLE_MPI=ON \
        -DCMAKE_CXX_FLAGS="-O3" \
        ..
    
    # Compile and install
    make -j$(nproc)
    make install
    
    # Clean up build files to reduce image size
    cd /opt/tempestextremes
    rm -rf build

    # Create writable ZDOTDIR
    mkdir -p /opt/zshdir
    
    # Create .zshrc with Oh My Posh initialization and project setup
    cat > /opt/zshdir/.zshrc << 'EOF'
# Initialize Oh My Posh
eval "$(oh-my-posh init zsh --config /opt/themes/atomic.omp.json)"

# Change to project directory
cd /opt/project

# Activate virtual environment
source .venv/bin/activate

# Aliases
alias ll='ls -lah'
alias python='python3'
alias pip='uv pip'
alias duck='duckdb'

# Welcome message
echo ""
echo "Python: $(python3 --version)"
echo "UV: $(uv --version)"
echo "DuckDB: $(duckdb --version)"
echo "TempestExtremes: /opt/tempestextremes/bin"
echo "Project: /opt/project"
echo "Virtual Env: /opt/project/.venv"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
EOF

    # Also configure bashrc as fallback
    cat >> /root/.bashrc << 'BASHRC_EOF'

# Change to project directory
cd /opt/project

# Activate virtual environment
source .venv/bin/activate

# Aliases
alias ll='ls -lah'
alias python='python3'
alias pip='uv pip'
alias duck='duckdb'

# Welcome message
echo ""
echo "Thalassoica: "
echo ""
BASHRC_EOF

    # Clean up
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%files
    # Copy local atomic.omp.json if it exists (will override the downloaded one)
    atomic.omp.json /opt/themes/atomic.omp.json

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Thalassoica paths take priority
    export PATH=/opt/project/.venv/bin:/usr/local/bin:/opt/tempestextremes/bin:$PATH
    export PYTHONUNBUFFERED=1
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/lib/x86_64-linux-gnu:/opt/tempestextremes/lib:$LD_LIBRARY_PATH
    export PROJECT_DIR=/opt/project
    export UV_NO_CACHE=1
    export TERM=xterm-256color
    export ZDOTDIR=/opt/zshdir
    # TempestExtremes paths
    export TEMPEST_DIR=/opt/tempestextremes

%runscript
    cd /opt/project
    exec zsh

%startscript
    cd /opt/project
    exec zsh

%labels
    Author Aashray Chegu
    Version 1.0
    Description Thalassoica environment with TempestExtremes for sea ice cyclone imagery analysis
    ThalassoicaRepo https://github.com/aashraychegu/seaice-cyclone-imagery
    TempestExtremesRepo https://github.com/ClimateGlobalChange/tempestextremes

%help
    This container combines the Thalassoica Python environment with TempestExtremes.
    The Thalassoica setup takes priority in PATH and environment configuration.
    
    To build this container:
        apptainer build thalassoica.sif thalassoica.def
    
    To run interactively:
        apptainer shell thalassoica.sif
    
    Project directory: /opt/project
    Python virtual environment: /opt/project/.venv (auto-activated)
    TempestExtremes binaries: /opt/tempestextremes/bin
    
    Available TempestExtremes commands:
        - DetectNodes: Detect features based on thresholds
        - StitchNodes: Connect features across time
        - NodeFileEditor: Edit and filter node files
        - DetectBlobs: Detect closed contour features
        - StitchBlobs: Connect blobs across time
        - BlockingDevs: Calculate blocking deviations
    
    Available Python tools:
        - python3/python: Python 3.14
        - uv: Fast Python package installer
        - duckdb: In-process SQL OLAP database
        - GDAL tools for geospatial data
    
    For more information:
    Thalassoica: https://github.com/aashraychegu/seaice-cyclone-imagery
    TempestExtremes: https://climate.ucdavis.edu/tempestextremes.php