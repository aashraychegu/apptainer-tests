Bootstrap: docker
From: python:3.14-slim-bookworm

%post
    # Set environment variables for non-interactive installation
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC

    # Clean apt state before installing packages
    apt-get update
    apt-get install -y --no-install-recommends \
        curl \
        wget \
        ca-certificates \
        gcc \
        g++ \
        gfortran \
        make \
        cmake \
        git \
        build-essential \
        pkg-config \
        libpq-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libgeos-dev \
        libproj-dev \
        libsqlite3-dev \
        libbz2-dev \
        libffi-dev \
        libncurses-dev \
        libreadline-dev \
        liblzma-dev \
        zlib1g-dev \
        libzstd-dev \
        libjpeg-dev \
        libpng-dev \
        libtiff-dev \
        libhdf5-dev \
        libhdf5-hl-c++-dev \
        libhdf5-hl-fortran-dev \
        libnetcdf-dev \
        libnetcdf-c++4-dev \
        netcdf-bin \
        libopenblas-dev \
        liblz4-dev \
        libsnappy-dev \
        libbrotli-dev \
        proj-bin \
        libgeos++-dev \
        postgresql-client \
        postgis \
        unzip \
        gdal-bin \
        libgdal-dev \
        zsh \
        lsd \
        libopenmpi-dev \
        openmpi-bin \
        libboost-all-dev \
        libeigen3-dev \
        libarmadillo-dev \
        libgit2-dev

    # Install DuckDB CLI (only once)
    curl https://install.duckdb.org | sh
    rm -rf /root/.duckdb

    # Install UV to a system-wide location
    curl -LsSf https://astral.sh/uv/install.sh | sh
    rm -rf /root/.local

    # Install Oh My Posh
    wget https://github.com/JanDeDobbeleer/oh-my-posh/releases/latest/download/posh-linux-amd64 -O /usr/local/bin/oh-my-posh
    chmod +x /usr/local/bin/oh-my-posh

    # Create theme directory and download atomic theme
    mkdir -p /opt/themes
    wget -q -O /opt/themes/atomic.omp.json https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/atomic.omp.json

    # Clone the seaice-cyclone-imagery repository
    git clone --depth 1 --no-checkout https://github.com/aashraychegu/seaice-cyclone-imagery.git /opt/project
    cd /opt/project
    git checkout -f origin/master

    # Create venv and sync dependencies
    /usr/local/bin/uv venv --python 3.14
    /usr/local/bin/uv sync

    # Clean up uv cache for smaller image
    rm -rf ~/.cache/uv

    # Install TempestExtremes
    git clone --depth 1 --no-checkout https://github.com/ClimateGlobalChange/tempestextremes.git /opt/tempestextremes
    cd /opt/tempestextremes
    git checkout -f origin/main

    # Create build directory
    mkdir -p build
    cd build

    # Configure with CMake (optimizations for performance)
    cmake \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/tempestextremes \
        -DENABLE_MPI=ON \
        -DCMAKE_CXX_FLAGS="-O3 -march=native -flto" \
        -DCMAKE_VERBOSE_MAKEFILE=OFF \
        ..

    # Compile and install
    make -j$(nproc)
    make install

    # Run ldconfig to update library cache
    ldconfig

    # Clean up build files to reduce image size
    cd /opt/tempestextremes
    rm -rf build CMakeCache.txt CMakeFiles/

    # Clean up git metadata
    git clean -fdX

    # Create writable ZDOTDIR directory
    mkdir -p /opt/zshdir
    chmod 755 /opt/zshdir

    # Create .zshrc with Oh My Posh initialization and project setup
    cat > /opt/zshdir/.zshrc << 'EOF'
# Initialize Oh My Posh
eval "$(oh-my-posh init zsh --config /opt/themes/atomic.omp.json)"

# Change to project directory
cd /opt/project

# Activate virtual environment
source .venv/bin/activate

# Aliases
alias ll='ls -lah'
alias python='python3'
alias pip='uv pip'
alias duck='duckdb'
alias cleanup='apt-get clean && rm -rf /var/lib/apt/lists/*'

# Welcome message
echo ""
echo "╭─── Thalassoica Environment ──╮"
echo "│  Python: $(python3 --version) │"
echo "│  UV: $(uv --version)          │"
echo "│  DuckDB: $(duckdb --version)  │"
echo "│  TempestExtremes: /opt/tempestextremes/bin │"
echo "│  Project: /opt/project        │"
echo "╰───────────────────────────────╯"
echo ""
EOF

    # Also configure bashrc as fallback
    cat >> /root/.bashrc << 'BASHRC_EOF'

# Thalassoica Bash initialization
echo ""
echo "╭─── Thalassoica Environment ──╮"
echo "│  Python: $(python3 --version) │"
echo "│  UV: $(uv --version)          │"
echo "│  DuckDB: $(duckdb --version)  │"
echo "│  TempestExtremes: /opt/tempestextremes/bin │"
echo "│  Project: /opt/project        │"
echo "╰───────────────────────────────╯"
echo ""
BASHRC_EOF

    # Configure .bash_profile for bash login shells
    cat >> /root/.bash_profile << 'BASH_PROFILE_EOF'
# Source ~/.bashrc for Thalassoica environment
if [ -f ~/.bashrc ]; then
    source ~/.bashrc
fi
BASH_PROFILE_EOF

    # Clean up package lists
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # Remove any unused dependencies
    apt-get autoremove -y

%files
    # Copy local atomic.omp.json if it exists (will override the downloaded one)
    atomic.omp.json /opt/themes/atomic.omp.json

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/opt/project/.venv/bin:/usr/local/bin:/opt/tempestextremes/bin:$PATH
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/opt/project/.venv/lib/python3.14/site-packages:$PYTHONPATH
    export LD_LIBRARY_PATH=/opt/tempestextremes/lib:/usr/local/lib:/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH
    export PROJECT_DIR=/opt/project
    export TEMPEST_DIR=/opt/tempestextremes
    export ZDOTDIR=/opt/zshdir
    export TERM=xterm-256color
    export PYTHONNOUSERSITE=1
    export PIP_NO_PYTHON_VERSION_WARNING=1
    export VIRTUAL_ENV=/opt/project/.venv
    export VIRTUAL_ENV_PROMPT="(thalassoica)"

%runscript
    cd /opt/project
    exec zsh

%startscript
    cd /opt/project
    exec zsh

%labels
    Author="Aashray Chegu"
    Version="1.0"
    Description="Thalassoica environment with TempestExtremes for sea ice cyclone imagery analysis"
    ThalassoicaRepo="https://github.com/aashraychegu/seaice-cyclone-imagery"
    TempestExtremesRepo="https://github.com/ClimateGlobalChange/tempestextremes"
    License="MIT"

%help
    This container combines the Thalassoica Python environment with TempestExtremes.
    The Thalassoica setup takes priority in PATH and environment configuration.

    To build this container:
        apptainer build thalassoica.sif thalassoica.def

    To run interactively:
        apptainer shell thalassoica.sif

    Project directory: /opt/project
    Python virtual environment: /opt/project/.venv (auto-activated)
    TempestExtremes binaries: /opt/tempestextremes/bin

    Available TempestExtremes commands:
        - DetectNodes: Detect features based on thresholds
        - StitchNodes: Connect features across time
        - NodeFileEditor: Edit and filter node files
        - DetectBlobs: Detect closed contour features
        - StitchBlobs: Connect blobs across time
        - BlockingDevs: Calculate blocking deviations

    Available Python tools:
        - python3/python: Python 3.14
        - uv: Fast Python package installer
        - duckdb: In-process SQL OLAP database
        - GDAL tools for geospatial data

    Available commands:
        apptainer exec thalassoica.sif python --version
        apptainer exec thalassoica.sif uv --version
        apptainer exec thalassoica.sif duckdb --version
        apptainer exec thalassoica.sif /opt/tempestextremes/bin/detectNodes --help

    For more information:
    Thalassoica: https://github.com/aashraychegu/seaice-cyclone-imagery
    TempestExtremes: https://climate.ucdavis.edu/tempestextremes.php
