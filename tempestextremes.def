Bootstrap: docker
From: ubuntu:22.04

%post
    # Set environment variables for non-interactive installation
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC
    
    # Update and install dependencies
    apt-get update && apt-get install -y \
        build-essential \
        cmake \
        git \
        wget \
        libnetcdf-dev \
        libnetcdf-c++4-dev \
        netcdf-bin \
        libhdf5-dev \
        libopenmpi-dev \
        openmpi-bin \
        ca-certificates \
        && rm -rf /var/lib/apt/lists/*
    
    # Clone TempestExtremes repository
    cd /opt
    git clone https://github.com/ClimateGlobalChange/tempestextremes.git
    cd tempestextremes
    
    # Create build directory
    mkdir -p build
    cd build
    
    # Configure with CMake
    cmake \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/tempestextremes \
        -DENABLE_MPI=ON \
        -DCMAKE_CXX_FLAGS="-O3" \
        ..
    
    # Compile and install
    make -j$(nproc)
    make install
    
    # Clean up build files to reduce image size
    cd /opt/tempestextremes
    rm -rf build

%environment
    # Add TempestExtremes binaries to PATH
    export PATH=/opt/tempestextremes/bin:$PATH
    export LD_LIBRARY_PATH=/opt/tempestextremes/lib:$LD_LIBRARY_PATH

%runscript
    echo "TempestExtremes container"
    echo "Available executables are in /opt/tempestextremes/bin"
    echo "Usage: singularity exec <container> <command>"
    echo ""
    echo "Example commands:"
    echo "  - DetectNodes"
    echo "  - StitchNodes"
    echo "  - DetectBlobs"
    echo "  - BlockingDevs"
    echo ""
    exec /bin/bash "$@"

%labels
    Author Your Name
    Version 1.0
    Description TempestExtremes - Feature detection and tracking for climate data
    URL https://github.com/ClimateGlobalChange/tempestextremes

%help
    This container includes TempestExtremes compiled with MPI support.
    
    To build this container:
        singularity build tempestextremes.sif tempestextremes.def
    
    To run interactively:
        singularity shell tempestextremes.sif
    
    To execute a specific command:
        singularity exec tempestextremes.sif DetectNodes --help
    
    Available executables include:
        - DetectNodes: Detect features based on thresholds
        - StitchNodes: Connect features across time
        - NodeFileEditor: Edit and filter node files
        - DetectBlobs: Detect closed contour features
        - StitchBlobs: Connect blobs across time
        - BlockingDevs: Calculate blocking deviations
        - And many more in /opt/tempestextremes/bin
    
    For more information, visit:
    https://climate.ucdavis.edu/tempestextremes.php